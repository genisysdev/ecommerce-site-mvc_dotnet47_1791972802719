<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Legacy Store</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <a class="navbar-brand" href="@Url.Content("~/")">&#128722; Legacy Store</a>
            </div>
            <div class="navbar-right" style="padding:8px;">
                @if (User.Identity.IsAuthenticated)
                {
                    <span style="color:#ccc;margin-right:8px;">Hi, @User.Identity.Name</span>
                    <a href="@Url.Action("Orders", "Account")" class="btn btn-default navbar-btn">My Orders</a>
                    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link navbar-btn">Log off</button>
                    }
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="btn btn-default navbar-btn">Login</a>
                    <a href="@Url.Action("Register", "Account")" class="btn btn-default navbar-btn">Register</a>
                }
                <span id="mini-cart-container">@Html.Action("MiniCart", "Cart")</span>
            </div>
        </div>
    </div>
    <div class="container body-content">
        <div class="row">
            <div class="col-md-3">
                @Html.Action("Sidebar", "Product")
            </div>
            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Legacy eCommerce (.NET 4.7 MVC)</p>
        </footer>
    </div>
    <script src="~/Scripts/jquery-3.4.1.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    <script src="~/Scripts/app/catalog.js"></script>
    <script src="~/Scripts/app/cart.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
