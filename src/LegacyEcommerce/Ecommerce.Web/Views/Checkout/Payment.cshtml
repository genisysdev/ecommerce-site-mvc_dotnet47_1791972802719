@model Ecommerce.Core.ViewModels.PaymentViewModel
@{
    ViewBag.Title = "Checkout - Payment";
    var cartTotal = (decimal)ViewBag.CartTotal;
    var shippingCost = (decimal)ViewBag.ShippingCost;
    var grandTotal = (decimal)ViewBag.GrandTotal;
}
<h2>Checkout &mdash; Step 3 of 3: Payment</h2>

<div class="well">
    Cart: <strong>@cartTotal.ToString("C")</strong> +
    Shipping: <strong>@shippingCost.ToString("C")</strong> =
    Total: <strong>@grandTotal.ToString("C")</strong>
</div>

@using (Html.BeginForm("Payment", "Checkout", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.CardName)
        @Html.TextBoxFor(m => m.CardName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.CardName, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.CardNumber)
        @Html.TextBoxFor(m => m.CardNumber, new { @class = "form-control", autocomplete = "off" })
        @Html.ValidationMessageFor(m => m.CardNumber, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Expiry)
        @Html.TextBoxFor(m => m.Expiry, new { @class = "form-control", placeholder = "MM/YY" })
        @Html.ValidationMessageFor(m => m.Expiry, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Cvv)
        @Html.TextBoxFor(m => m.Cvv, new { @class = "form-control", autocomplete = "off" })
        @Html.ValidationMessageFor(m => m.Cvv, "", new { @class = "text-danger" })
    </div>
    <button type="submit" class="btn btn-success">Place Order</button>
    <a href="@Url.Action("Shipping", "Checkout")">&laquo; Back to shipping</a>
}

@section Scripts {
    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
}
