@model Ecommerce.Core.Models.Cart
@if (!Model.Items.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Product</th><th>Price</th><th>Qty</th><th>Line total</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr data-product-id="@item.ProductId">
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>
                        <input type="number" min="0" value="@item.Quantity"
                               class="form-control cart-qty" style="width:80px" />
                    </td>
                    <td>@item.LineTotal.ToString("C")</td>
                    <td><button class="btn btn-danger btn-sm cart-remove">Remove</button></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-right">Total</th>
                <th>@Model.TotalPrice.ToString("C")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
}
